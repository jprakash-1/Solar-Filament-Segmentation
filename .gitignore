# Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.zip

# Kaggle credentials
kaggle.json
.kaggle/
.env

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Outputs -- ignore every subfolder wholesale (including stray ones, e.g. leftover
# EDA analysis dirs from other branches sharing this working directory), except the
# three known ones, which are re-ignored one level deeper so only their .gitkeep
# survives -- a bare `!outputs/<sub>/.gitkeep` negation alone would also expose
# everything else inside that subfolder, which is not the intent.
outputs/*
!outputs/checkpoints/
!outputs/logs/
!outputs/submissions/
outputs/checkpoints/*
outputs/logs/*
outputs/submissions/*
!outputs/checkpoints/.gitkeep
!outputs/logs/.gitkeep
!outputs/submissions/.gitkeep

# Notebook checkpoints already covered above; nbconvert artifacts
*.nbconvert.ipynb

# OS
.DS_Store
